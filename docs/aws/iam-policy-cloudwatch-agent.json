{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteApplicationLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/log-aggregator/*:*"
    },
    {
      "Sid": "DescribeForAgentHealth",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    }
  ]
}
