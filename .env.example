POSTGRES_USER=loguser
POSTGRES_PASSWORD=logpass123
POSTGRES_DB=logaggregator

# Used by the backend container. Host is the Compose service name "postgres".
DATABASE_URL=postgresql://loguser:logpass123@postgres:5432/logaggregator

# collector/ (Phase 3B) — point DATABASE_URL at localhost:5432 instead when running the
# collector outside Docker. AWS credentials come from boto3's default chain, not from here.
AWS_REGION=ap-south-1
LOG_GROUP_NAME=/log-aggregator/application
POSTGRES_USER=loguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logaggregator
DATABASE_URL=postgresql://loguser:change-me@postgres:5432/logaggregator
CORRELATION_WINDOW_SECONDS=300
MAX_INCIDENT_GAP_SECONDS=900
RAG_TOP_K=5
OPENAI_MODEL=gpt-4o-mini
# Optional external integrations (the deterministic application works without them)
OPENAI_API_KEY=
AWS_REGION=ap-south-1
AWS_LOG_GROUP=
SNS_TOPIC_ARN=
ALERT_CRITICAL=true
ALERT_HIGH=false
